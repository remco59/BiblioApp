# Kopieer naar `.env` op de server (chmod 600) en vul in. Zet dit bestand NOOIT in git.
SITE_ADDRESS=bibliotheek.example.nl

# Images (worden door de deploy-pipeline gepusht)
REGISTRY=ghcr.io/remco59/biblioapp
IMAGE_TAG=latest

# Database
POSTGRES_PASSWORD=verander-dit-naar-een-lang-willekeurig-wachtwoord

# Mail (verificatie, wachtwoord-reset, meldingen)
SMTP_HOST=smtp.example.nl
SMTP_PORT=587
MAIL_FROM="Bibliotheek <noreply@example.nl>"

# Monitoring: Prometheus scrapet /api/metrics met dit token (minimaal 16 tekens)
METRICS_TOKEN=verander-dit-naar-een-lang-willekeurig-token

# Betalingen: laat leeg/none tot een echte provider is gekoppeld (zie docs)
PAYMENT_PROVIDER=none

# Optioneel: cover-opslag in S3/MinIO in plaats van het lokale volume
# S3_ENDPOINT=https://s3.example.nl
# S3_BUCKET=covers
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Backups
BACKUP_RETENTION_DAYS=14
BACKUP_HOUR_UTC=2
# BACKUP_REMOTE=s3remote:biblio-backups
