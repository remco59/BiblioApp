# SITE_ADDRESS: bijv. bibliotheek.example.nl (Caddy regelt het HTTPS-certificaat automatisch via Let's Encrypt).
# Lokaal testen: SITE_ADDRESS=localhost
{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# camera: alleen voor het scannen van barcodes op de balie
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; media-src 'self' blob:; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# Interne endpoints nooit publiek: metrics worden binnen het docker-netwerk gescrapet
	@internal path /api/metrics /api/metrics/* /api/docs /api/docs/*
	respond @internal 404

	handle /api/* {
		reverse_proxy api:3000 {
			health_uri /api/health
			health_interval 15s
			# Server-Sent Events direct doorsturen
			flush_interval -1
		}
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /sw.js Cache-Control "no-cache"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
