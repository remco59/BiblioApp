  "info": {
    "title": "BiblioApp API",
    "description": "",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "database": {
            "type": "boolean"
          }
        },
        "required": [
          "status",
          "database"
        ]
      },
      "AuthorDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "BookDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "isbn": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "language": {
            "type": "string"
          },
          "publishedYear": {
            "type": "number",
            "nullable": true
          },
          "genre": {
            "type": "string",
            "nullable": true
          },
          "authors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuthorDto"
            }
          },
          "copiesTotal": {
            "type": "number",
            "description": "Totaal aantal exemplaren"
          },
          "copiesAvailable": {
            "type": "number",
            "description": "Beschikbare exemplaren (afgeleid)"
          }
        },
        "required": [
          "id",
          "title",
          "language",
          "authors",
          "copiesTotal",
          "copiesAvailable"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 10
          }
        },
        "required": [
          "email",
          "name",
          "password"
        ]
      },
      "TokenDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        },
        "required": [
          "token"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SessionUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "MEMBER",
              "LIBRARIAN",
              "ADMIN"
            ]
          },
          "memberNumber": {
            "type": "string",
            "nullable": true
          },
          "csrfToken": {
            "type": "string",
            "description": "Stuur mee als X-CSRF-Token bij POST/PATCH/DELETE"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role",
          "memberNumber",
          "csrfToken"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 10
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      }
    }
  }
}
