generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Author {
  id        Int          @id @default(autoincrement())
  name      String
  createdAt DateTime     @default(now())
  books     BookAuthor[]
}

model Genre {
  id    Int    @id @default(autoincrement())
  name  String @unique
  books Book[]
}

model Book {
  id            Int            @id @default(autoincrement())
  title         String
  isbn          String?        @unique
  description   String?
  language      String         @default("nl")
  publishedYear Int?
  coverUrl      String?
  coverKey      String?
  seriesId      Int?
  seriesNumber  Int?
  series        Series?        @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  tags          BookTag[]
  genreId       Int?
  genre         Genre?         @relation(fields: [genreId], references: [id])
  authors       BookAuthor[]
  copies        Copy[]
  reservations  Reservation[]
  reviews       Review[]
  wishlisted    WishlistItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([title])
}

model Series {
  id    Int    @id @default(autoincrement())
  name  String @unique
  books Book[]
}

model Tag {
  id    Int       @id @default(autoincrement())
  name  String    @unique
  books BookTag[]
}

model BookTag {
  bookId Int
  tagId  Int
  book   Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([bookId, tagId])
}

model BookAuthor {
  bookId   Int
  authorId Int
  book     Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author   Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([bookId, authorId])
}

enum CopyStatus {
  AVAILABLE
  LOANED
  RESERVED_HOLD
  LOST
  DAMAGED
}

model Copy {
  id           Int           @id @default(autoincrement())
  barcode      String        @unique
  status       CopyStatus    @default(AVAILABLE)
  bookId       Int
  book         Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  loans        Loan[]
  reservations Reservation[]

  @@index([bookId])
}

enum Role {
  MEMBER
  LIBRARIAN
  ADMIN
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model User {
  id              Int            @id @default(autoincrement())
  email           String         @unique
  name            String
  passwordHash    String
  role            Role           @default(MEMBER)
  emailVerifiedAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  locale          String         @default("nl")
  disabledAt      DateTime?
  totpSecret      String?
  totpEnabledAt   DateTime?
  totpLastStep    Int?
  member          Member?
  notifications   Notification[]
  sessions        Session[]
  emailTokens     EmailToken[]
  auditLogs       AuditLog[]
  recoveryCodes   RecoveryCode[]
  reviews         Review[]
  wishlistItems   WishlistItem[]
  suggestions     Suggestion[]
}

model Member {
  id              Int           @id @default(autoincrement())
  userId          Int           @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberNumber    String        @unique
  membershipUntil DateTime
  blocked         Boolean       @default(false)
  blockedReason   String?
  createdAt       DateTime      @default(now())
  expiryNoticeFor DateTime?
  loans           Loan[]
  fines           Fine[]
  reservations    Reservation[]
}

model Session {
  id        String   @id // sha256 van het cookie-token
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  csrfToken String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailToken {
  id        Int            @id @default(autoincrement())
  userId    Int
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  detail    Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
}

enum LoanOutcome {
  RETURNED
  LOST
  DAMAGED
}

model Loan {
  id              Int          @id @default(autoincrement())
  copyId          Int
  copy            Copy         @relation(fields: [copyId], references: [id])
  memberId        Int
  member          Member       @relation(fields: [memberId], references: [id])
  loanedAt        DateTime     @default(now())
  dueAt           DateTime
  returnedAt      DateTime?
  outcome         LoanOutcome?
  renewals        Int          @default(0)
  reminderSentAt  DateTime?
  overdueNoticeAt DateTime?
  loanedById      Int?
  returnedById    Int?
  fines           Fine[]

  @@index([memberId])
  @@index([copyId])
  @@index([dueAt])
  @@index([loanedAt])
}

enum FineReason {
  OVERDUE
  LOST
  DAMAGED
}

model Fine {
  id             Int             @id @default(autoincrement())
  memberId       Int
  member         Member          @relation(fields: [memberId], references: [id])
  loanId         Int?
  loan           Loan?           @relation(fields: [loanId], references: [id])
  reason         FineReason
  amountCents    Int
  note           String?
  waivedAt       DateTime?
  waivedById     Int?
  createdAt      DateTime        @default(now())
  payments       Payment[]
  onlinePayments OnlinePayment[]

  @@index([memberId])
}

model Payment {
  id           Int      @id @default(autoincrement())
  fineId       Int
  fine         Fine     @relation(fields: [fineId], references: [id], onDelete: Cascade)
  amountCents  Int
  method       String   @default("CASH")
  receivedById Int?
  paidAt       DateTime @default(now())
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum ReservationStatus {
  WAITING
  READY
  FULFILLED
  CANCELLED
  EXPIRED
}

model Reservation {
  id        Int               @id @default(autoincrement())
  bookId    Int
  book      Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  memberId  Int
  member    Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status    ReservationStatus @default(WAITING)
  copyId    Int?
  copy      Copy?             @relation(fields: [copyId], references: [id], onDelete: SetNull)
  createdAt DateTime          @default(now())
  readyAt   DateTime?
  expiresAt DateTime?
  closedAt  DateTime?

  @@index([bookId, status])
  @@index([memberId])
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  emailedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model RecoveryCode {
  id       Int       @id @default(autoincrement())
  userId   Int
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String
  usedAt   DateTime?

  @@index([userId])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id             Int          @id @default(autoincrement())
  bookId         Int
  book           Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating         Int
  body           String?
  status         ReviewStatus @default(PENDING)
  moderationNote String?
  moderatedById  Int?
  moderatedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([bookId, userId])
  @@index([bookId, status])
}

model WishlistItem {
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    Int
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, bookId])
}

enum SuggestionStatus {
  SUBMITTED
  APPROVED
  REJECTED
  ORDERED
  ADDED
}

model Suggestion {
  id          Int              @id @default(autoincrement())
  userId      Int
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  author      String
  isbn        String?
  reason      String?
  status      SuggestionStatus @default(SUBMITTED)
  staffNote   String?
  handledById Int?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status])
}

model EmailTemplate {
  id      Int    @id @default(autoincrement())
  type    String
  locale  String
  subject String
  body    String

  @@unique([type, locale])
}

enum OnlinePaymentStatus {
  PENDING
  PAID
  FAILED
}

model OnlinePayment {
  id          Int                 @id @default(autoincrement())
  fineId      Int
  fine        Fine                @relation(fields: [fineId], references: [id], onDelete: Cascade)
  amountCents Int
  provider    String
  providerRef String              @unique
  status      OnlinePaymentStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  paidAt      DateTime?

  @@index([fineId])
}
