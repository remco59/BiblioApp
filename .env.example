DATABASE_URL=postgresql://biblio:biblio@localhost:5432/biblio?schema=public
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=BiblioApp <noreply@biblio.local>
# Aantal inlog/registratie-pogingen per minuut per IP
AUTH_RATE_LIMIT_MAX=10
# Cover-opslag: zonder S3_ENDPOINT worden covers lokaal bewaard (apps/api/uploads).
# Met `docker compose up` kun je MinIO gebruiken door onderstaande te activeren:
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=covers
# S3_ACCESS_KEY=biblio
# S3_SECRET_KEY=biblio-secret

# --- Productie en beveiliging (zie deploy/.env.production.example en docs/beheerhandleiding.md) ---
# RATE_LIMIT_MAX=300            # algemene limiet per IP per minuut
# TRUST_PROXY=1                 # 0 als de API niet achter een reverse proxy staat
# LOG_LEVEL=info                # silent|error|warn|info|debug
# ENABLE_DOCS=1                 # Swagger-UI (/api/docs) staat in productie standaard uit
# METRICS_TOKEN=                # verplicht in productie; Prometheus gebruikt dit als Bearer-token
# PAYMENT_PROVIDER=mock         # mock (alleen ontwikkeling) of none
